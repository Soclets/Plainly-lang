english
procedure.main[none]:
    #name: Text = "Mia";
    #score: Whole = 120;
    show_text.format("{#name} has {#score} points.");
    show_text.format("Line one{new_line}Line two");
    show_text("Not filled: {#name}");
    show_text.format("Type \{#name} for your name, and a lone } stays.");
    show_text.same_line("Your move: ");
    show_text.format.same_line("{#name}? ");
    show_text("done");
    #line: Text = be.Text.format("{#name}: {#score}");
    show_text(#line);
    show_text("a" & new_line & "b");
end procedure.main
