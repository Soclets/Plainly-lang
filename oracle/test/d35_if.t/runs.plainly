english
procedure.main[none] returns nothing:
    #hp: Whole = 5;
    #name: Text = "Mia";
    if #hp at_least 1:
        show_text("alive");
    else:
        show_text("gone");
    end if
    if #hp > 10:
        show_text("strong");
    else if #hp == 5:
        show_text("five");
    else:
        show_text("weak");
    end if
    if #hp == 5 or #hp > 100 and #hp < 0:
        show_text("and first");
    end if
    if not #hp > 10 and.both #hp at_most 5:
        show_text("not strong");
    end if
    if compare_Text.same_bytes(#name, "Mia"):
        show_text("same");
    end if
    if compare_Text.same_normalized("é", "é"):
        show_text("same normalized");
    end if
    if not compare_Text.same_bytes("é", "é"):
        show_text("stored differently");
    end if
    if not compare_Text.same_normalized("ก่ิ", "กิ่"):
        show_text("above vowel order differs");
    end if
end procedure.main
