english

procedure.main[none] returns nothing:
    mutable #hp: Whole = 50;
    change #hp = #hp |> heal(by: 30) |> heal;
    #hp |> be.Text |> show_text;
    #hp + 1 |> be.Text |> show_text;
    "HP: " & be.Text(#hp) |> show_text;
    "Mia" |> greet;
    #hp |> double |> be.Text |> show_text.same_line;
    show_text("!");
end procedure.main

procedure heal[#health: Whole, #amount: Whole] returns Whole:
    labels [#amount as by];
    defaults [#amount = 10];
    return #health + #amount;
end procedure heal

procedure greet[#name: Text] returns nothing:
    show_text.format("Hi, {#name}!");
end procedure greet

procedure double[#n: Whole] returns Whole:
    return #n x 2;
end procedure double
